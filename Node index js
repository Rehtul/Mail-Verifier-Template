app.post('/request-code', async (req, res) => {
    const { email } = req.body;

    if (!email || typeof email !== "string") {
        return res.status(400).send({ message: "Invalid email" });
    }

    const code = codeGenerator();

    const emailSent = await sendEmailCode(email, code);
    // if (!emailSent) {
    //     return res.status(502).send({ message: "Failed to send email" });
    // }

    codes.set(email, {
        code,
        expiresAt: Date.now() + CODE_TTL_MS
    });

    res.send({
        message: "Verification code sent"
    });
});

app.post('/confirm-code', (req, res) => {
    const { email, code } = req.body;

    const record = codes.get(email);

    if (!record) {
        return res.status(400).send({ message: "No code requested" });
    }

    if (Date.now() > record.expiresAt) {
        codes.delete(email);
        return res.status(410).send({ message: "Code expired" });
    }

    if (code !== record.code) {
        return res.status(401).send({ message: "Invalid code" });
    }

    codes.delete(email);
    res.send({ message: "Code confirmed" });
});

app.listen(port, () => {
    console.log(`Server is running on port ${port}`);
});
